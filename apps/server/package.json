{
  "name": "@mymind/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./desktop-bridge": "./src/desktopBridge.ts"
  },
  "scripts": {
    "dev": "MYMIND_DATA_DIR=${MYMIND_DATA_DIR:-../../.data} MYMIND_VITE_PORT=${MYMIND_VITE_PORT:-5173} tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@mymind/agent": "workspace:*",
    "@mymind/db": "workspace:*",
    "@mymind/domain": "workspace:*",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0"
  }
}
