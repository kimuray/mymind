{
  "name": "mymind",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "deps:check": "depcruise --config .dependency-cruiser.cjs packages $(test -d apps && echo apps)",
    "design:check": "node scripts/check-design-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm deps:check && pnpm design:check && pnpm docs:check && pnpm test",
    "doctor": "node scripts/doctor.mjs",
    "progress": "node scripts/progress.mjs",
    "update-app": "node scripts/update-app.mjs",
    "restore-backup": "tsx apps/server/src/restoreCli.ts",
    "mcp": "pnpm --silent --dir packages/mcp start",
    "eval-prompt": "tsx apps/server/src/evalPromptCli.ts",
    "start": "pnpm --filter @mymind/server start",
    "desktop:start": "pnpm build && MYMIND_DATA_DIR=${MYMIND_DATA_DIR:-$PWD/.data} pnpm --filter @mymind/desktop start",
    "desktop:dev": "pnpm --filter @mymind/desktop build && MYMIND_DATA_DIR=${MYMIND_DATA_DIR:-$PWD/.data} MYMIND_VITE_PORT=${MYMIND_VITE_PORT:-5173} pnpm --filter @mymind/desktop start",
    "desktop:package": "pnpm build && pnpm --filter @mymind/desktop package",
    "desktop:install-electron": "NODE_USE_ENV_PROXY=1 node apps/desktop/node_modules/electron/install.js",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:check": "node scripts/docs-build.mjs --check",
    "docs:open": "node scripts/docs-build.mjs && open docs-site/docs/index.html",
    "docker:dev": "docker compose up dev",
    "docker:check": "docker compose run --rm check",
    "docker:e2e": "docker compose run --rm e2e",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down --volumes"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "^18.4.0",
    "markdown-it": "^15.0.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
